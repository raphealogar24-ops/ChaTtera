rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET (Default Deny)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // =========================================================================
    // 2. ENTITY VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'keyFingerprint', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'keyFingerprint', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.email == request.auth.token.email &&
        data.keyFingerprint is string && data.keyFingerprint.size() >= 16 && data.keyFingerprint.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'handle',
          'statusText',
          'publicKeyX',
          'publicKeyY',
          'keyFingerprint',
          'discoverable',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'handle',
          'statusText',
          'publicKeyX',
          'publicKeyY',
          'keyFingerprint',
          'discoverable',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 32 && data.handle.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.statusText is string && data.statusText.size() >= 1 && data.statusText.size() <= 160 &&
        data.publicKeyX is string && data.publicKeyX.size() >= 20 && data.publicKeyX.size() <= 128 &&
        data.publicKeyY is string && data.publicKeyY.size() >= 20 && data.publicKeyY.size() <= 128 &&
        data.keyFingerprint is string && data.keyFingerprint.size() >= 16 && data.keyFingerprint.size() <= 128 &&
        data.discoverable is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
          'id',
          'participantA',
          'participantB',
          'participantAName',
          'participantBName',
          'participantAHandle',
          'participantBHandle',
          'status',
          'lastCiphertextPreview',
          'messageCount',
          'lastSenderId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'participantA',
          'participantB',
          'participantAName',
          'participantBName',
          'participantAHandle',
          'participantBHandle',
          'status',
          'lastCiphertextPreview',
          'messageCount',
          'lastSenderId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.participantA is string && data.participantA.size() >= 1 && data.participantA.size() <= 128 && data.participantA.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.participantB is string && data.participantB.size() >= 1 && data.participantB.size() <= 128 && data.participantB.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.participantA == request.auth.uid || data.participantB == request.auth.uid) &&
        data.participantAName is string && data.participantAName.size() >= 1 && data.participantAName.size() <= 60 &&
        data.participantBName is string && data.participantBName.size() >= 1 && data.participantBName.size() <= 60 &&
        data.participantAHandle is string && data.participantAHandle.size() >= 2 && data.participantAHandle.size() <= 32 && data.participantAHandle.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.participantBHandle is string && data.participantBHandle.size() >= 2 && data.participantBHandle.size() <= 32 && data.participantBHandle.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.status is string && data.status.size() >= 6 && data.status.size() <= 8 &&
        (data.status == 'active' || data.status == 'archived' || data.status == 'locked') &&
        data.lastCiphertextPreview is string && data.lastCiphertextPreview.size() >= 1 && data.lastCiphertextPreview.size() <= 160 &&
        data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 1000000 &&
        data.lastSenderId is string && data.lastSenderId.size() >= 1 && data.lastSenderId.size() <= 128 && data.lastSenderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.lastSenderId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEncryptedMessage(data) {
      return data.keys().hasAll([
          'id',
          'conversationId',
          'senderId',
          'recipientId',
          'senderKeyFingerprint',
          'ciphertext',
          'iv',
          'algorithm',
          'deliveryStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'conversationId',
          'senderId',
          'recipientId',
          'senderKeyFingerprint',
          'ciphertext',
          'iv',
          'algorithm',
          'deliveryStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.conversationId is string && data.conversationId.size() >= 1 && data.conversationId.size() <= 128 && data.conversationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 && data.senderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 && data.recipientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (data.senderId == request.auth.uid || data.recipientId == request.auth.uid) &&
        data.senderKeyFingerprint is string && data.senderKeyFingerprint.size() >= 16 && data.senderKeyFingerprint.size() <= 128 &&
        data.ciphertext is string && data.ciphertext.size() >= 1 && data.ciphertext.size() <= 8192 &&
        data.iv is string && data.iv.size() >= 12 && data.iv.size() <= 64 &&
        data.algorithm is string && data.algorithm.size() == 20 && data.algorithm == 'ECDH-P256-AES256GCM' &&
        data.deliveryStatus is string && data.deliveryStatus.size() >= 4 && data.deliveryStatus.size() <= 9 &&
        (data.deliveryStatus == 'sent' || data.deliveryStatus == 'delivered' || data.deliveryStatus == 'verified' || data.deliveryStatus == 'revoked') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 3. RELATIONAL MASTER GATE HELPERS
    // =========================================================================

    function isConversationParticipant(conversationId) {
      let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return conv.participantA == request.auth.uid || conv.participantB == request.auth.uid;
    }

    function isConversationActiveAndParticipant(conversationId) {
      let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return (conv.participantA == request.auth.uid || conv.participantB == request.auth.uid) &&
        conv.status != 'locked';
    }

    function isConversationActiveForMessage(conversationId, senderId, recipientId) {
      let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return conv.status != 'locked' &&
        ((conv.participantA == senderId && conv.participantB == recipientId) ||
         (conv.participantB == senderId && conv.participantA == recipientId));
    }

    // =========================================================================
    // 4. COLLECTION MATCH BLOCKS
    // =========================================================================

    // 4.1 Private User PII Vault (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() && isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserPrivate(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/profiles/$(userId));

      allow update: if isSignedIn() && isVerified() &&
        isValidId(userId) &&
        isValidUserPrivate(incoming()) && (
          // Action: RotateKeyFingerprint
          (request.auth.uid == userId &&
           existing().uid == request.auth.uid &&
           incoming().uid == existing().uid &&
           incoming().email == existing().email &&
           incoming().createdAt == existing().createdAt &&
           incoming().updatedAt == request.time &&
           incoming().diff(existing()).affectedKeys().hasOnly(['keyFingerprint', 'updatedAt']))
        );

      allow delete: if false;
    }

    // 4.2 Public Cryptographic Key Directory (/profiles/{userId}) — Zero PII
    match /profiles/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) &&
        (request.auth.uid == userId || existing().discoverable == true);

      allow list: if isSignedIn() && isVerified() &&
        existing().discoverable == true;

      allow create: if isSignedIn() && isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(userId));

      allow update: if isSignedIn() && isVerified() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) && (
          // Action: UpdateProfileMetadata
          (request.auth.uid == userId &&
           existing().uid == request.auth.uid &&
           incoming().uid == existing().uid &&
           incoming().publicKeyX == existing().publicKeyX &&
           incoming().publicKeyY == existing().publicKeyY &&
           incoming().keyFingerprint == existing().keyFingerprint &&
           incoming().createdAt == existing().createdAt &&
           incoming().updatedAt == request.time &&
           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'statusText', 'discoverable', 'updatedAt'])) ||
          // Action: RotatePublicKey
          (request.auth.uid == userId &&
           existing().uid == request.auth.uid &&
           incoming().uid == existing().uid &&
           incoming().displayName == existing().displayName &&
           incoming().handle == existing().handle &&
           incoming().statusText == existing().statusText &&
           incoming().discoverable == existing().discoverable &&
           incoming().createdAt == existing().createdAt &&
           incoming().updatedAt == request.time &&
           incoming().diff(existing()).affectedKeys().hasOnly(['publicKeyX', 'publicKeyY', 'keyFingerprint', 'updatedAt'])) ||
          // Action: FullProfileSync
          (request.auth.uid == userId &&
           existing().uid == request.auth.uid &&
           incoming().uid == existing().uid &&
           incoming().createdAt == existing().createdAt &&
           incoming().updatedAt == request.time &&
           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'statusText', 'publicKeyX', 'publicKeyY', 'keyFingerprint', 'discoverable', 'updatedAt']))
        );

      allow delete: if false;
    }

    // 4.3 E2EE Conversations (/conversations/{conversationId})
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isVerified() && isValidId(conversationId) &&
        (existing().participantA == request.auth.uid || existing().participantB == request.auth.uid);

      allow list: if isSignedIn() && isVerified() &&
        (existing().participantA == request.auth.uid || existing().participantB == request.auth.uid);

      allow create: if isSignedIn() && isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming()) &&
        incoming().id == conversationId &&
        incoming().status == 'active' &&
        incoming().messageCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/profiles/$(incoming().participantA)) &&
        exists(/databases/$(database)/documents/profiles/$(incoming().participantB));

      allow update: if isSignedIn() && isVerified() &&
        isValidId(conversationId) &&
        isValidConversation(incoming()) &&
        existing().status != 'locked' &&
        (existing().participantA == request.auth.uid || existing().participantB == request.auth.uid) &&
        incoming().id == existing().id &&
        incoming().participantA == existing().participantA &&
        incoming().participantB == existing().participantB &&
        incoming().participantAName == existing().participantAName &&
        incoming().participantBName == existing().participantBName &&
        incoming().participantAHandle == existing().participantAHandle &&
        incoming().participantBHandle == existing().participantBHandle &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: TransmitEncryptedPacket (atomic batch with message creation)
          (incoming().status == 'active' &&
           incoming().messageCount == existing().messageCount + 1 &&
           incoming().diff(existing()).affectedKeys().hasOnly(['lastCiphertextPreview', 'messageCount', 'lastSenderId', 'status', 'updatedAt'])) ||
          // Action: UpdateSessionState (archive, unarchive, or permanently lock session)
          (incoming().messageCount == existing().messageCount &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastSenderId', 'updatedAt']))
        );

      allow delete: if false;

      // 4.4 Encrypted Message Packets (/conversations/{conversationId}/messages/{messageId})
      match /messages/{messageId} {
        allow get: if isSignedIn() && isVerified() &&
          isValidId(conversationId) && isValidId(messageId) &&
          (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid) &&
          isConversationParticipant(conversationId);

        allow list: if isSignedIn() && isVerified() &&
          (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid);

        allow create: if isSignedIn() && isVerified() &&
          isValidId(conversationId) && isValidId(messageId) &&
          isValidEncryptedMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().conversationId == conversationId &&
          incoming().senderId == request.auth.uid &&
          incoming().deliveryStatus == 'sent' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isConversationActiveForMessage(conversationId, incoming().senderId, incoming().recipientId) &&
          existsAfter(/databases/$(database)/documents/conversations/$(conversationId)) &&
          getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.updatedAt == request.time &&
          getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastSenderId == request.auth.uid;

        allow update: if isSignedIn() && isVerified() &&
          isValidId(conversationId) && isValidId(messageId) &&
          isValidEncryptedMessage(incoming()) &&
          existing().deliveryStatus != 'revoked' &&
          incoming().id == existing().id &&
          incoming().conversationId == existing().conversationId &&
          incoming().senderId == existing().senderId &&
          incoming().recipientId == existing().recipientId &&
          incoming().senderKeyFingerprint == existing().senderKeyFingerprint &&
          incoming().iv == existing().iv &&
          incoming().algorithm == existing().algorithm &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isConversationActiveAndParticipant(conversationId) && (
            // Tier 1 Action (Sender): RevokeEncryptedPacket
            (existing().senderId == request.auth.uid &&
             incoming().deliveryStatus == 'revoked' &&
             incoming().ciphertext == '[REVOKED_CIPHERTEXT]' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['ciphertext', 'deliveryStatus', 'updatedAt'])) ||
            // Tier 2 Action (Recipient): AcknowledgeOrVerifyPacket
            (existing().recipientId == request.auth.uid &&
             (incoming().deliveryStatus == 'delivered' || incoming().deliveryStatus == 'verified') &&
             incoming().ciphertext == existing().ciphertext &&
             incoming().diff(existing()).affectedKeys().hasOnly(['deliveryStatus', 'updatedAt']))
          );

        allow delete: if false;
      }
    }
  }
}
